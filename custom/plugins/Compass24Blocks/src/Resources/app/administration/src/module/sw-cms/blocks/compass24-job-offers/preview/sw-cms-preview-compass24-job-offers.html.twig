{% block sw_cms_preview_compass24_job_offers %}
    <div class="sw-cms-preview-compass24-job-offers">
        <div class="sw-cms-preview-compass24-job-offers__header">
            <div class="title">Stellenangebote</div>
            <div class="subtitle">Aktuelle Jobs bei Compass24</div>
        </div>
        <div class="sw-cms-preview-compass24-job-offers__filter-bar">
            <div class="search-placeholder">🔍 Suchen…</div>
            <div class="filter-selects">
                <span class="filter-pill">Bereich</span>
                <span class="filter-pill">Art</span>
                <span class="filter-pill">Standort</span>
            </div>
        </div>
        <div class="sw-cms-preview-compass24-job-offers__jobs">
            <div class="job-preview-item">
                <div class="job-preview-item__title">Full Stack Entwickler (m/w/d)</div>
                <div class="job-preview-item__tags">
                    <span class="tag tag--type">Vollzeit</span>
                    <span class="tag tag--dept">IT & E-Commerce</span>
                    <span class="tag tag--loc">📍 Ascheberg</span>
                </div>
            </div>
            <div class="job-preview-item">
                <div class="job-preview-item__title">Kaufmann/-frau (m/w/d)</div>
                <div class="job-preview-item__tags">
                    <span class="tag tag--type">Ausbildung</span>
                    <span class="tag tag--dept">Vertrieb</span>
                    <span class="tag tag--loc">📍 Ascheberg</span>
                </div>
            </div>
            <div class="job-preview-item">
                <div class="job-preview-item__title">Lagermitarbeiter (m/w/d)</div>
                <div class="job-preview-item__tags">
                    <span class="tag tag--type">Vollzeit</span>
                    <span class="tag tag--dept">Logistik</span>
                    <span class="tag tag--loc">📍 Ascheberg</span>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
