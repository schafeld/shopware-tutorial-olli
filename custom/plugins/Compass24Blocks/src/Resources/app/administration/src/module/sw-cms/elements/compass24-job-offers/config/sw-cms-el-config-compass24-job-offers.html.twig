{% block sw_cms_element_config_compass24_job_offers %}
    <div class="sw-cms-el-config-compass24-job-offers">

        {# ===================== General Settings ===================== #}
        <div class="config-section">
            <h3 class="config-section__title">Allgemeine Einstellungen</h3>

            <sw-text-field
                v-model="headerTitle"
                label="Überschrift"
                placeholder="Aktuelle Stellenangebote">
            </sw-text-field>

            <sw-text-field
                v-model="headerSubtitle"
                label="Untertitel"
                placeholder="Finde deinen Platz im Team">
            </sw-text-field>

            <sw-text-field
                v-model="applicationEmail"
                label="Bewerbungs-E-Mail-Adresse"
                placeholder="sekretariat@compass24.de">
            </sw-text-field>
        </div>

        {# ===================== Job Listings ===================== #}
        <div class="config-section">
            <div class="config-section__header">
                <h3 class="config-section__title">
                    Stellenangebote
                    <span class="config-section__count">({{ localJobs.length }})</span>
                </h3>
                <button class="c24-btn c24-btn--primary" @click="addJob">
                    + Neue Stelle
                </button>
            </div>

            {# Empty state #}
            <div v-if="localJobs.length === 0" class="config-empty">
                <p>Noch keine Stellenangebote angelegt.</p>
                <p>Klicke auf <strong>+ Neue Stelle</strong>, um zu beginnen.</p>
            </div>

            {# Job cards #}
            <div v-for="(job, jobIndex) in localJobs" :key="job.id" class="job-card">

                {# --- Card header (click to expand/collapse) --- #}
                <div class="job-card__header" @click="toggleJob(jobIndex)">
                    <div class="job-card__header-left">
                        <span class="job-card__number">#{{ jobIndex + 1 }}</span>
                        <div class="job-card__header-text">
                            <span class="job-card__title">{{ job.title || 'Neue Stelle (bitte ausfüllen)' }}</span>
                            <span v-if="job.department" class="job-card__dept">{{ job.department }}</span>
                        </div>
                    </div>
                    <div class="job-card__header-right">
                        <button
                            v-if="jobIndex > 0"
                            class="job-card__icon-btn"
                            @click.stop="moveJobUp(jobIndex)"
                            title="Nach oben verschieben">
                            ↑
                        </button>
                        <button
                            v-if="jobIndex < localJobs.length - 1"
                            class="job-card__icon-btn"
                            @click.stop="moveJobDown(jobIndex)"
                            title="Nach unten verschieben">
                            ↓
                        </button>
                        <button
                            class="job-card__icon-btn"
                            @click.stop="duplicateJob(jobIndex)"
                            title="Stelle duplizieren">
                            ⧉
                        </button>
                        <span class="job-card__chevron">{{ expandedJobIndex === jobIndex ? '▲' : '▼' }}</span>
                    </div>
                </div>

                {# --- Card body (expanded form) --- #}
                <div v-if="expandedJobIndex === jobIndex" class="job-card__body">

                    {# Basic fields #}
                    <div class="form-group">
                        <h4 class="form-group__title">Grunddaten</h4>

                        <sw-text-field
                            v-model="job.title"
                            label="Stellenbezeichnung (inkl. m/w/d)"
                            placeholder="z.B. Full Stack Entwickler (m/w/d)">
                        </sw-text-field>

                        <div class="form-row">
                            <div class="form-row__col">
                                <label class="c24-label">Bereich</label>
                                <select v-model="job.department" class="c24-select">
                                    <option value="">-- Bitte wählen --</option>
                                    <option v-for="opt in departmentOptions" :key="opt.value" :value="opt.value">
                                        {{ opt.label }}
                                    </option>
                                </select>
                            </div>
                            <div class="form-row__col">
                                <label class="c24-label">Beschäftigungsart</label>
                                <select v-model="job.employmentType" class="c24-select">
                                    <option v-for="opt in employmentTypeOptions" :key="opt.value" :value="opt.value">
                                        {{ opt.label }}
                                    </option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-row__col">
                                <sw-text-field
                                    v-model="job.location"
                                    label="Standort"
                                    placeholder="z.B. Ascheberg">
                                </sw-text-field>
                            </div>
                            <div class="form-row__col">
                                <sw-text-field
                                    v-model="job.startDate"
                                    label="Starttermin"
                                    placeholder="z.B. Ab sofort">
                                </sw-text-field>
                            </div>
                        </div>

                        <sw-text-field
                            v-model="job.workModel"
                            label="Arbeitsmodell (optional, leer lassen wenn nicht zutreffend)"
                            placeholder="z.B. Hybrid (3 Tage vor Ort, 2 Tage remote)">
                        </sw-text-field>

                        <sw-textarea-field
                            v-model="job.description"
                            label="Kurzbeschreibung (1–3 Sätze)"
                            placeholder="Wir suchen…">
                        </sw-textarea-field>
                    </div>

                    {# Sections (tasks, profile, benefits) #}
                    <div class="form-group">
                        <div class="form-group__header">
                            <h4 class="form-group__title">Detail-Abschnitte</h4>
                            <button class="c24-btn c24-btn--small" @click="addSection(jobIndex)">
                                + Abschnitt
                            </button>
                        </div>

                        <div v-for="(section, sIdx) in job.sections" :key="sIdx" class="section-block">
                            <div class="section-block__header">
                                <sw-text-field
                                    v-model="section.heading"
                                    label="Überschrift"
                                    placeholder="z.B. Deine Aufgaben:">
                                </sw-text-field>
                                <button
                                    class="section-block__remove"
                                    @click="removeSection(jobIndex, sIdx)"
                                    title="Abschnitt entfernen">
                                    ✕
                                </button>
                            </div>

                            <div class="section-block__items">
                                <div v-for="(item, iIdx) in section.items" :key="iIdx" class="section-item">
                                    <input
                                        type="text"
                                        class="c24-input"
                                        :value="item"
                                        @input="updateSectionItem(jobIndex, sIdx, iIdx, $event.target.value)"
                                        :placeholder="'Punkt ' + (iIdx + 1)">
                                    <button
                                        class="section-item__remove"
                                        @click="removeSectionItem(jobIndex, sIdx, iIdx)"
                                        title="Punkt entfernen">
                                        ✕
                                    </button>
                                </div>
                                <button class="c24-btn c24-btn--ghost c24-btn--small" @click="addSectionItem(jobIndex, sIdx)">
                                    + Punkt hinzufügen
                                </button>
                            </div>
                        </div>

                        <div v-if="job.sections.length === 0" class="config-empty config-empty--small">
                            <p>Keine Abschnitte vorhanden. Klicke auf <strong>+ Abschnitt</strong>.</p>
                        </div>
                    </div>

                    {# Delete job #}
                    <div class="job-card__footer">
                        <button class="c24-btn c24-btn--danger" @click="removeJob(jobIndex)">
                            Stelle löschen
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
