{% block sw_cms_element_config_compass24_key_metrics %}
    <div class="sw-cms-el-config-compass24-key-metrics">
        <h3>Compass24 Key Metrics Configuration</h3>
        <p class="description">Configure the 5 key metrics to display in the banner.</p>

        <!-- Metric 1 -->
        <div class="metric-config-group">
            <h4>Metric 1</h4>
            <sw-text-field
                v-model="metric1Value"
                label="Value"
                placeholder="e.g., 1979">
            </sw-text-field>
            <sw-text-field
                v-model="metric1Label"
                label="Label"
                placeholder="e.g., Gründungsjahr">
            </sw-text-field>
        </div>

        <!-- Metric 2 -->
        <div class="metric-config-group">
            <h4>Metric 2</h4>
            <sw-text-field
                v-model="metric2Value"
                label="Value"
                placeholder="e.g., 42.000+">
            </sw-text-field>
            <sw-text-field
                v-model="metric2Label"
                label="Label"
                placeholder="e.g., Artikel">
            </sw-text-field>
        </div>

        <!-- Metric 3 -->
        <div class="metric-config-group">
            <h4>Metric 3</h4>
            <sw-text-field
                v-model="metric3Value"
                label="Value"
                placeholder="e.g., 400+">
            </sw-text-field>
            <sw-text-field
                v-model="metric3Label"
                label="Label"
                placeholder="e.g., Seiten Katalog">
            </sw-text-field>
        </div>

        <!-- Metric 4 -->
        <div class="metric-config-group">
            <h4>Metric 4</h4>
            <sw-text-field
                v-model="metric4Value"
                label="Value"
                placeholder="e.g., 5.000">
            </sw-text-field>
            <sw-text-field
                v-model="metric4Label"
                label="Label"
                placeholder="e.g., Pakete täglich">
            </sw-text-field>
        </div>

        <!-- Metric 5 -->
        <div class="metric-config-group">
            <h4>Metric 5</h4>
            <sw-text-field
                v-model="metric5Value"
                label="Value"
                placeholder="e.g., 11">
            </sw-text-field>
            <sw-text-field
                v-model="metric5Label"
                label="Label"
                placeholder="e.g., Länder weltweit">
            </sw-text-field>
        </div>
    </div>
{% endblock %}
