{% block cms_element_compass24_key_metrics %}
    <div class="cms-element-compass24-key-metrics">
        {% block cms_element_compass24_key_metrics_component %}
            <div class="compass24-key-metrics-component">
                {% block cms_element_compass24_key_metrics_section %}
                    <section class="metrics-section" aria-label="Compass24 Schlüsselzahlen">
                        {% block cms_element_compass24_key_metrics_container %}
                            <div class="metrics-container" role="list">
                                
                                {% block cms_element_compass24_key_metrics_metric_1 %}
                                    {# Metric 1 #}
                                    <div class="metric-item" role="listitem">
                                        <span class="metric-item__value" aria-label="{{ element.config.metric1Label.value }}">
                                            {{ element.config.metric1Value.value }}
                                        </span>
                                        <span class="metric-item__label">
                                            {{ element.config.metric1Label.value }}
                                        </span>
                                    </div>
                                {% endblock %}
                                
                                {% block cms_element_compass24_key_metrics_metric_2 %}
                                    {# Metric 2 #}
                                    <div class="metric-item" role="listitem">
                                        <span class="metric-item__value" aria-label="{{ element.config.metric2Label.value }}">
                                            {{ element.config.metric2Value.value }}
                                        </span>
                                        <span class="metric-item__label">
                                            {{ element.config.metric2Label.value }}
                                        </span>
                                    </div>
                                {% endblock %}
                                
                                {% block cms_element_compass24_key_metrics_metric_3 %}
                                    {# Metric 3 #}
                                    <div class="metric-item" role="listitem">
                                        <span class="metric-item__value" aria-label="{{ element.config.metric3Label.value }}">
                                            {{ element.config.metric3Value.value }}
                                        </span>
                                        <span class="metric-item__label">
                                            {{ element.config.metric3Label.value }}
                                        </span>
                                    </div>
                                {% endblock %}
                                
                                {% block cms_element_compass24_key_metrics_metric_4 %}
                                    {# Metric 4 #}
                                    <div class="metric-item" role="listitem">
                                        <span class="metric-item__value" aria-label="{{ element.config.metric4Label.value }}">
                                            {{ element.config.metric4Value.value }}
                                        </span>
                                        <span class="metric-item__label">
                                            {{ element.config.metric4Label.value }}
                                        </span>
                                    </div>
                                {% endblock %}
                                
                                {% block cms_element_compass24_key_metrics_metric_5 %}
                                    {# Metric 5 #}
                                    <div class="metric-item" role="listitem">
                                        <span class="metric-item__value" aria-label="{{ element.config.metric5Label.value }}">
                                            {{ element.config.metric5Value.value }}
                                        </span>
                                        <span class="metric-item__label">
                                            {{ element.config.metric5Label.value }}
                                        </span>
                                    </div>
                                {% endblock %}
                                
                            </div>
                        {% endblock %}
                    </section>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
