{% block gotowebinar_stats_card %}
    <sw-card 
        :title="$tc('gotowebinar-sheets.dashboard.cardStatistics')" 
        :isLoading="isLoading"
        class="gotowebinar-stats-card">

        <div class="gotowebinar-stats-card__content">
            
            {% block gotowebinar_stats_card_total %}
                <div class="gotowebinar-stats-card__stat">
                    <sw-icon name="default-basic-stack-line" size="32"></sw-icon>
                    <div class="gotowebinar-stats-card__stat-value">
                        {{ stats.totalExports || 0 }}
                    </div>
                    <div class="gotowebinar-stats-card__stat-label">
                        {{ $tc('gotowebinar-sheets.stats.total') }}
                    </div>
                </div>
            {% endblock %}

            {% block gotowebinar_stats_card_pending %}
                <div class="gotowebinar-stats-card__stat">
                    <sw-icon name="default-time-clock" size="32"></sw-icon>
                    <div class="gotowebinar-stats-card__stat-value">
                        <sw-label :variant="statusVariant">
                            {{ stats.pendingExports || 0 }}
                        </sw-label>
                    </div>
                    <div class="gotowebinar-stats-card__stat-label">
                        {{ $tc('gotowebinar-sheets.stats.pending') }}
                    </div>
                </div>
            {% endblock %}

            {% block gotowebinar_stats_card_last %}
                <div class="gotowebinar-stats-card__stat">
                    <sw-icon name="default-action-check" size="32"></sw-icon>
                    <div class="gotowebinar-stats-card__stat-value">
                        {{ lastExportFormatted }}
                    </div>
                    <div class="gotowebinar-stats-card__stat-label">
                        {{ $tc('gotowebinar-sheets.stats.lastExport') }}
                    </div>
                </div>
            {% endblock %}

        </div>

        {% block gotowebinar_stats_card_warning %}
            <sw-alert v-if="!isConfigured" variant="warning" class="gotowebinar-stats-card__warning">
                {{ $tc('gotowebinar-sheets.oauth.statusNotConnected') }}
            </sw-alert>
        {% endblock %}

    </sw-card>
{% endblock %}
