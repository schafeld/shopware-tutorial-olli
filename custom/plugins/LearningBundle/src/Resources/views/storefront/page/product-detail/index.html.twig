{#
    Product Detail Page - GTM Data Enhancement + Recommendations
    
    This template extends the product detail page to add:
    1. Minimal GTM tracking data (server-side via GtmPageSubscriber)
    2. Product Recommendations Widget
#}

{% sw_extends '@Storefront/storefront/page/product-detail/index.html.twig' %}

{# Keep page_product_detail as-is, GTM data is pushed via page.extensions.gtmDataLayer #}

{# Enhance the buy form with minimal GTM data for JS tracking #}
{% block page_product_detail_buy_form %}
    {% set gtmEnabled = config('LearningBundle.config.gtmEnabled') %}
    
    {% if gtmEnabled and page.product %}
        {% set product = page.product %}
        
        {# Add minimal GTM data - avoid accessing lazy-loaded relations #}
        <div class="gtm-buy-form-wrapper"
             data-product-detail-page="true"
             data-product-id="{{ product.id }}"
             data-product-number="{{ product.productNumber }}">
            {{ parent() }}
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{# Add Recommendations Widget after product description #}
{% block page_product_detail_description_content_inner %}
    {{ parent() }}

    {# Make sales channel access key available to JavaScript #}
    <script>
        console.log('[Template] Setting access key from context.salesChannel.accessKey:', '{{ context.salesChannel.accessKey }}');
        window.salesChannelAccessKey = '{{ context.salesChannel.accessKey }}';
        console.log('[Template] window.salesChannelAccessKey is now:', window.salesChannelAccessKey);
    </script>

    {# Recommendations Widget #}
    <div class="learning-recommendations-wrapper">
        <div class="learning-recommendations"
            data-learning-recommendation="true"
            data-product-id="{{ page.product.id }}"
            data-access-key="{{ context.salesChannel.accessKey }}">

            <div class="recommendations-header">
                <h3 class="recommendations-title">
                    {{ "learning.recommendations.title"|trans }}
                </h3>
                <p class="recommendations-subtitle">
                    {{ "learning.recommendations.subtitle"|trans }}
                </p>
            </div>

            {# Loading State #}
            <div class="recommendations-loading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>{{ "learning.recommendations.loading"|trans }}</p>
            </div>

            {# Recommendations Container (populated via JS) #}
            <div class="recommendations-carousel"
                    data-recommendations-carousel="true">
                    {# Dynamically loaded content #}
            </div>

            {# Error State #}
            <div class="recommendations-error" style="display: none;">
                <p class="text-muted">
                    {{ "learning.recommendations.error"|trans }}
                </p>
            </div>

            {# Empty State #}
            <div class="recommendations-empty" style="display: none;">
                <p class="text-muted">
                    {{ "learning.recommendations.empty"|trans }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}
